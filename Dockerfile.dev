# Local development image. Deployment uses the Dockerfile.
FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.2 /uv /uvx /bin/

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Keep the virtual environment outside /app. The Compose source mount
# would hide a virtual environment created inside /app.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-group pipeline \
    && chmod -R a+rX /opt/venv

EXPOSE 8000

CMD ["bash", "entrypoint.dev.sh"]
